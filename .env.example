# ============================================================
# Project CHOWKI — Campus Outbreak Surveillance System
# Made by Synthreaper | github.com/synthreaper/chowki
# File: .env.example | Last Modified: 2026-08-22
# ============================================================

CHOWKI_ENV=development
CHOWKI_DEBUG=true
CHOWKI_HOST=0.0.0.0
CHOWKI_PORT=8000
CHOWKI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (SQLite for local dev, PostgreSQL for prod)
CHOWKI_DATABASE_URL=sqlite:///./chowki_surveillance.db

# Security & Cryptography
CHOWKI_JWT_SECRET=chowki-surveillance-secret-key-32-bytes-min!
CHOWKI_JWT_ALGORITHM=HS256
CHOWKI_SALT_SEED=chowki-weekly-rotating-salt-2026
CHOWKI_TOKEN_EXPIRE_MINUTES=15

# Epidemiological Scan Statistics Settings
CHOWKI_STPSS_MC_RUNS=999
CHOWKI_STPSS_P_THRESH=0.05
CHOWKI_STPSS_BIN_HOURS=4

# DPDP Act 2023 Compliance
CHOWKI_K_ANONYMITY=5
CHOWKI_RETENTION_DAYS=30
CHOWKI_PURGE_HOURS=72

# Environmental Thresholds
CHOWKI_CHLORINE_THRESH=0.2
CHOWKI_CHLORINE_TARGET=0.5
CHOWKI_TURBIDITY_THRESH=4.0
