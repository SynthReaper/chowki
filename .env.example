# ============================================================
# Project CHOWKI — Vercel Production Environment Variables
# Made by Synthreaper | github.com/synthreaper/chowki
# ============================================================

# ------------------------------------------------------------
# Application Environment & CORS
# ------------------------------------------------------------
CHOWKI_ENV=production
CHOWKI_DEBUG=false
CHOWKI_CORS_ORIGINS=*

# ------------------------------------------------------------
# Database Connection (Optional - Leave blank for Serverless SQLite)
# If using Neon / Supabase / Vercel Postgres, paste your connection string here:
# ------------------------------------------------------------
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------
# Cryptography & Security Secrets
# ------------------------------------------------------------
CHOWKI_JWT_SECRET=chowki-surveillance-prod-secret-key-32-bytes-min-2026!
CHOWKI_JWT_ALGORITHM=HS256
CHOWKI_TOKEN_EXPIRE_MINUTES=60
CHOWKI_SALT_SEED=chowki-weekly-rotating-salt-2026

# ------------------------------------------------------------
# Epidemiological STPSS Engine Settings
# ------------------------------------------------------------
CHOWKI_STPSS_MC_RUNS=999
CHOWKI_STPSS_P_THRESH=0.05
CHOWKI_STPSS_BIN_HOURS=4

# ------------------------------------------------------------
# DPDP Act 2023 Compliance & IoT Thresholds
# ------------------------------------------------------------
CHOWKI_K_ANONYMITY=5
CHOWKI_CHLORINE_THRESH=0.2
CHOWKI_CHLORINE_TARGET=0.5
CHOWKI_TURBIDITY_THRESH=4.0
